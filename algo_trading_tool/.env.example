# Application Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database
DATABASE_URL=sqlite:///trading_data.db

# Angel One Broker API
ANGEL_ONE_CLIENT_ID=your_angel_one_client_id
ANGEL_ONE_PASSWORD=your_angel_one_password
ANGEL_ONE_API_KEY=your_angel_one_api_key
ANGEL_ONE_SECRET_KEY=your_angel_one_secret_key

# Dhan Broker API
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# Real-time Data Sources (Paid)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
POLYGON_API_KEY=your_polygon_key
TWELVEDATA_API_KEY=your_twelvedata_key

# Trading Configuration
DEFAULT_CAPITAL=100000
MAX_RISK_PER_TRADE=0.02
MAX_PORTFOLIO_RISK=0.06
DEFAULT_TIMEFRAME=1m
LOOKBACK_PERIOD=50

# Risk Management
DEFAULT_STOP_LOSS=0.02
DEFAULT_TARGET=0.04
TRAILING_STOP=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

# Redis (for caching real-time data)
REDIS_URL=redis://localhost:6379/0

# Options Trading
MAX_STRIKES_TO_MONITOR=10
MIN_TIME_TO_EXPIRY=1